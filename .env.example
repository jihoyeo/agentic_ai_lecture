# 이 파일을 복사해서 ".env" 로 저장한 뒤, 본인의 키를 채우세요.
#   cp .env.example .env

# Google AI Studio 무료 API 키 — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your-key-here

# (선택) 다른 제공자를 쓸 경우
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 사용할 제공자 / 모델 (기본값: gemini)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
